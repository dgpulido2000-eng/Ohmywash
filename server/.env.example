SQUARE_ACCESS_TOKEN=your_access_token
SQUARE_LOCATION_ID=your_location_id
SQUARE_APPLICATION_ID=your_application_id
SQUARE_APPLICATION_SECRET=your_application_secret
# "production" (default) or "sandbox" — must match the credentials above
SQUARE_ENVIRONMENT=production
PORT=3000

# --- Manual booking approval email ---
# Bookings are no longer created in Square instantly — an email is sent
# with Accept/Decline buttons, and the real Square booking is only created
# when the owner clicks Accept. Sent via the Resend HTTP API (NOT SMTP —
# Render's free plan blocks outbound SMTP, so Gmail SMTP would hang
# forever with no error). Sign up free at https://resend.com with the
# email that should receive booking requests, then create an API key.
RESEND_API_KEY=re_your_api_key
# Must be the same email address used to sign up for Resend — the default
# sender (onboarding@resend.dev, no domain setup needed) can only send to
# your own Resend account email until you verify a custom domain.
NOTIFY_EMAIL=your_email@gmail.com
# Any long random string — used to sign the Accept/Decline email links so
# they can't be forged. Generate one with: openssl rand -hex 32
APPROVAL_SECRET=change_me_to_a_long_random_string
